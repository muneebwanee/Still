PUBLIC_ORIGIN=https://share.example.com
# Configure your own STUN/TURN service. No public provider is silently selected.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Replace with >=32 cryptographically random bytes, kept on the server only.
TURN_SECRET=REPLACE_WITH_A_RANDOM_SERVER_SECRET
